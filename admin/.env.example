# ================================================
# TFI Admin Dashboard — Environment Variables Template
# ================================================
# Copy this file to .env (for local dev) or .env.production (for production)
# NEVER commit the actual .env files — only this template

# Backend API base URL
VITE_API_URL="http://localhost:3001/api"

# Supabase — get these from your Supabase project settings > API
VITE_SUPABASE_URL="https://<your-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
